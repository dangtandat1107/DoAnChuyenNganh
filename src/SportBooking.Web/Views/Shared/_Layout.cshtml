@{
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    var initial = string.IsNullOrWhiteSpace(fullName) ? "?"
        : fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Last()[..1].ToUpper();
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - FSS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-fss">
  <div class="container">
    <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">FSS<small>Friendly Sport Space</small></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" asp-controller="Courts" asp-action="Index">Tìm sân</a></li>
        @if (User.IsInRole("Customer")) { <li class="nav-item"><a class="nav-link" asp-controller="Bookings" asp-action="My">Lịch của tôi</a></li> }
        @if (User.IsInRole("Owner") || User.IsInRole("Admin"))
        {
          <li class="nav-item"><a class="nav-link" asp-controller="Courts" asp-action="Manage">Quản lý sân</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Bookings" asp-action="Manage">Duyệt lịch</a></li>
        }
        @if (User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a></li> }
      </ul>
      <div class="d-flex align-items-center">
        @if (User.Identity?.IsAuthenticated == true)
        {
          <div class="dropdown">
            <a class="btn btn-sm btn-light dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
              <span class="avatar avatar-sm">@initial</span> @fullName
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Hồ sơ của tôi</a></li>
              <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index" asp-route-tab="password">Đổi mật khẩu</a></li>
              @if (User.IsInRole("Customer")) { <li><a class="dropdown-item" asp-controller="Bookings" asp-action="My">Lịch của tôi</a></li> }
              <li><hr class="dropdown-divider" /></li>
              <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger">Đăng xuất</button></form></li>
            </ul>
          </div>
        }
        else
        {
          <a class="btn btn-sm btn-outline-light me-2" asp-controller="Account" asp-action="Login">Đăng nhập</a>
          <a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Register">Đăng ký</a>
        }
      </div>
    </div>
  </div>
</nav>
<main class="container py-4">
  @if (TempData["Msg"] != null) { <div class="alert alert-success">@TempData["Msg"]</div> }
  @if (TempData["Err"] != null) { <div class="alert alert-danger">@TempData["Err"]</div> }
  @RenderBody()
</main>
<footer class="text-center text-muted small py-4">© FSS - Friendly Sport Space</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
