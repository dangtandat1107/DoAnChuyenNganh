@model ForgotPasswordVm
@{ ViewData["Title"] = "Quên mật khẩu"; }
<div class="row justify-content-center"><div class="col-md-5">
  <div class="card panel-card"><div class="card-body p-4">
    <h4>Quên mật khẩu</h4>
    <p class="text-muted">Nhập email đã đăng ký. Chúng tôi sẽ gửi mã xác nhận 6 chữ số đến email đó.</p>
    <form method="post">
      <div asp-validation-summary="ModelOnly" class="text-danger"></div>
      <div class="mb-3"><label class="form-label" asp-for="Email">Email</label><input class="form-control" asp-for="Email" type="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
      <button class="btn btn-success w-100">Gửi mã xác nhận</button>
    </form>
    <div class="text-center mt-3"><a asp-action="Login">Quay lại đăng nhập</a></div>
  </div></div>
</div></div>
