@model CourtDetailsVm
@{ ViewData["Title"] = Model.Court.Name; var now = DateTime.Now; }
<h3>@Model.Court.Name</h3>
<p>@Model.Court.SportType.DisplayName() · @Model.Court.District · @Model.Court.Address · <b>@Model.Court.PricePerHour.ToString("N0") đ/giờ</b></p>

<form method="get" class="row g-2 mb-3">
  <div class="col-auto"><input type="date" name="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
  <div class="col-auto"><button class="btn btn-outline-success">Xem ngày</button></div>
</form>

@if (Model.Court.Status == CourtStatus.Maintenance) { <div class="alert alert-warning">Sân đang bảo trì, tạm thời không nhận đặt.</div> }

<div class="d-flex flex-wrap gap-2">
@for (var h = IBookingService.OpenHour; h < IBookingService.CloseHour; h++)
{
  var busy = Model.BusyHours.Contains(h);
  var past = Model.Date.AddHours(h) < now;
  var disabled = busy || past || Model.Court.Status != CourtStatus.Active;
  if (User.IsInRole("Customer") && !disabled)
  {
    <form asp-controller="Bookings" asp-action="Create" method="post">
      <input type="hidden" name="courtId" value="@Model.Court.Id" />
      <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
      <input type="hidden" name="hour" value="@h" />
      <button class="btn btn-success" onclick="return confirm('Đặt @h:00 - @(h+1):00 ?')">@h:00 - @(h+1):00</button>
    </form>
  }
  else
  {
    <button class="btn @(busy ? "btn-danger" : "btn-outline-secondary")" disabled>@h:00 - @(h+1):00 @(busy ? "(đã đặt)" : "")</button>
  }
}
</div>
@if (!User.Identity!.IsAuthenticated) { <p class="mt-3"><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Đăng nhập</a> để đặt sân.</p> }
