@model List<Court>
@{ ViewData["Title"] = "Quản lý sân"; }
<div class="d-flex justify-content-between"><h3>Quản lý sân</h3><a class="btn btn-success" asp-action="Create">+ Thêm sân</a></div>
<table class="table mt-3 align-middle">
<tr><th>Tên</th><th>Môn</th><th>Quận</th><th>Giá/giờ</th><th>Trạng thái</th><th></th></tr>
@foreach (var c in Model)
{
  <tr><td>@c.Name</td><td>@c.SportType.DisplayName()</td><td>@c.District</td><td>@c.PricePerHour.ToString("N0")</td>
  <td><span class="badge @(c.Status == CourtStatus.Active ? "bg-success" : "bg-warning text-dark")">@c.Status.DisplayName()</span></td>
  <td class="text-end">
    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Sửa</a>
    <form asp-action="ToggleStatus" asp-route-id="@c.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">Đổi trạng thái</button></form>
  </td></tr>
}
</table>
